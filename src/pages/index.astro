---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>Travis Murdock</title>
    <meta name="description" content="Travis Murdock — Head of Go-To-Market at CopilotKit. Storyteller and Builder." />
    <meta name="author" content="Travis Murdock" />
    <meta name="creator" content="Travis Murdock" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0b0b0b" media="(prefers-color-scheme: dark)" />
    <meta name="google-site-verification" content="j4S068Gv4gmNSSK3G-icm2PkUUF93YcGUUcbFfK_Jsk" />

    <meta property="og:title" content="Travis Murdock" />
    <meta property="og:description" content="Head of Go-To-Market at CopilotKit. Storyteller and Builder." />
    <meta property="og:type" content="profile" />
    <meta property="og:url" content="https://travismurdock.com/" />
    <meta property="og:site_name" content="Travis Murdock" />
    <meta property="og:image" content="https://travismurdock.com/og-image.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Travis Murdock — Storyteller and Builder" />
    <meta property="profile:first_name" content="Travis" />
    <meta property="profile:last_name" content="Murdock" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@travismurdock" />
    <meta name="twitter:creator" content="@travismurdock" />
    <meta name="twitter:title" content="Travis Murdock" />
    <meta name="twitter:description" content="Head of Go-To-Market at CopilotKit. Storyteller and Builder." />
    <meta name="twitter:image" content="https://travismurdock.com/og-image.png" />
    <meta name="twitter:image:alt" content="Travis Murdock — Storyteller and Builder" />

    <link rel="canonical" href="https://travismurdock.com/" />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />

    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
  </head>
  <body>
    <main>
      <h1 class="sr-only">Travis Murdock — Storyteller and Builder</h1>
      <Image
        src={logo}
        alt="Travis Murdock — Storyteller and Builder"
        widths={[400, 800, 1200, 1600]}
        sizes="(max-width: 640px) 92vw, (max-width: 1024px) 70vw, 800px"
        loading="eager"
        decoding="async"
        format="webp"
        class="logo"
      />

      <p class="bio">
        Head of Go-To-Market at <a href="https://copilotkit.ai" rel="external">CopilotKit</a> &mdash;
        the open-source framework engineers use to build in-app AI copilots and agents.
        Lead mentor at Techstars Seattle. Based in the Greater Seattle Area.
      </p>

      <ul class="socials" aria-label="Social profiles">
        {socials.map((s) => (
          <li>
            <a
              href={s.href}
              rel="me noopener"
              target="_blank"
              aria-label={s.name}
              title={s.name}
            >
              <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <path d={s.path} fill="currentColor" />
              </svg>
            </a>
          </li>
        ))}
      </ul>

      <a class="email" href={`mailto:${email}`}>{email}</a>

      <details class="imessage">
        <summary>iMessage Contact Key</summary>
        <code>{imessageKey}</code>
      </details>
    </main>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light;
    --ink: #111;
    --muted: #555;
    --faint: #888;
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  html,
  body {
    margin: 0;
    padding: 0;
    height: 100%;
    background: #fff;
    color: var(--ink);
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto,
      'Helvetica Neue', Arial, sans-serif;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  main {
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: clamp(1.25rem, 3.5vw, 2.25rem);
    padding: 2rem 1.25rem;
  }

  .logo {
    width: 100%;
    max-width: 800px;
    height: auto;
    display: block;
  }

  .bio {
    max-width: 38rem;
    margin: 0;
    text-align: center;
    color: var(--muted);
    font-size: clamp(1rem, 2.2vw, 1.15rem);
    line-height: 1.55;
  }

  .bio a {
    color: inherit;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
    transition: color 150ms ease;
  }

  .bio a:hover,
  .bio a:focus-visible {
    color: var(--ink);
  }

  .socials {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    gap: 1.25rem;
  }

  .socials a {
    color: var(--muted);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    transition: color 150ms ease, transform 150ms ease;
  }

  .socials a:hover,
  .socials a:focus-visible {
    color: var(--ink);
    transform: translateY(-1px);
    outline: none;
  }

  .socials svg {
    width: 22px;
    height: 22px;
    display: block;
  }

  .email {
    color: var(--muted);
    text-decoration: none;
    font-size: clamp(0.95rem, 2.2vw, 1.15rem);
    letter-spacing: 0.02em;
    border-bottom: 1px solid transparent;
    transition: color 150ms ease, border-color 150ms ease;
  }

  .email:hover,
  .email:focus-visible {
    color: var(--ink);
    border-bottom-color: var(--ink);
    outline: none;
  }

  .imessage {
    font-size: 0.78rem;
    color: var(--faint);
    max-width: 38rem;
    text-align: center;
  }

  .imessage summary {
    cursor: pointer;
    list-style: none;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    user-select: none;
  }

  .imessage summary::-webkit-details-marker { display: none; }

  .imessage summary:hover,
  .imessage[open] summary {
    color: var(--muted);
  }

  .imessage code {
    display: block;
    margin-top: 0.5rem;
    font-family: ui-monospace, 'SF Mono', Menlo, Consolas, monospace;
    font-size: 0.72rem;
    word-break: break-all;
    user-select: all;
    color: var(--muted);
  }

  @media (prefers-color-scheme: dark) {
    :root {
      color-scheme: dark;
      --ink: #f4f4f4;
      --muted: #b6b6b6;
      --faint: #777;
    }
    html,
    body {
      background: #0b0b0b;
    }
    .logo {
      filter: invert(1);
    }
  }
</style>
