---
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';

const email = 'travis@travismurdock.com';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>Travis Murdock</title>
    <meta name="description" content="Travis Murdock — Storyteller and Builder. Head of GTM at CopilotKit." />
    <meta name="author" content="Travis Murdock" />
    <meta name="creator" content="Travis Murdock" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0b0b0b" media="(prefers-color-scheme: dark)" />

    <meta property="og:title" content="Travis Murdock" />
    <meta property="og:description" content="Storyteller and Builder. Head of GTM at CopilotKit." />
    <meta property="og:type" content="profile" />
    <meta property="og:url" content="https://travismurdock.com/" />
    <meta property="og:site_name" content="Travis Murdock" />
    <meta property="og:image" content="https://travismurdock.com/og-image.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Travis Murdock — Storyteller and Builder" />
    <meta property="profile:first_name" content="Travis" />
    <meta property="profile:last_name" content="Murdock" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@travismurdock" />
    <meta name="twitter:creator" content="@travismurdock" />
    <meta name="twitter:title" content="Travis Murdock" />
    <meta name="twitter:description" content="Storyteller and Builder. Head of GTM at CopilotKit." />
    <meta name="twitter:image" content="https://travismurdock.com/og-image.png" />
    <meta name="twitter:image:alt" content="Travis Murdock — Storyteller and Builder" />

    <link rel="canonical" href="https://travismurdock.com/" />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />

    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Person",
      "name": "Travis Murdock",
      "givenName": "Travis",
      "familyName": "Murdock",
      "url": "https://travismurdock.com/",
      "image": "https://travismurdock.com/og-image.png",
      "email": "mailto:travis@travismurdock.com",
      "description": "Storyteller and Builder. Head of GTM at CopilotKit.",
      "jobTitle": "Head of GTM",
      "worksFor": {
        "@type": "Organization",
        "name": "CopilotKit",
        "url": "https://copilotkit.ai"
      },
      "sameAs": [
        "https://www.linkedin.com/in/travismurdock/",
        "https://x.com/travismurdock",
        "https://github.com/travisrmurdock"
      ]
    })} />
  </head>
  <body>
    <main>
      <h1 class="sr-only">Travis Murdock — Storyteller and Builder</h1>
      <Image
        src={logo}
        alt="Travis Murdock — Storyteller and Builder"
        widths={[400, 800, 1200, 1600]}
        sizes="(max-width: 640px) 92vw, (max-width: 1024px) 70vw, 800px"
        loading="eager"
        decoding="async"
        format="webp"
        class="logo"
      />
      <a class="email" href={`mailto:${email}`}>{email}</a>
    </main>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light;
    --ink: #111;
    --muted: #555;
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  html,
  body {
    margin: 0;
    padding: 0;
    height: 100%;
    background: #fff;
    color: var(--ink);
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto,
      'Helvetica Neue', Arial, sans-serif;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  main {
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: clamp(1.5rem, 4vw, 3rem);
    padding: 2rem 1.25rem;
  }

  .logo {
    width: 100%;
    max-width: 800px;
    height: auto;
    display: block;
  }

  .email {
    color: var(--muted);
    text-decoration: none;
    font-size: clamp(0.95rem, 2.2vw, 1.15rem);
    letter-spacing: 0.02em;
    border-bottom: 1px solid transparent;
    transition: color 150ms ease, border-color 150ms ease;
  }

  .email:hover,
  .email:focus-visible {
    color: var(--ink);
    border-bottom-color: var(--ink);
    outline: none;
  }

  @media (prefers-color-scheme: dark) {
    :root {
      color-scheme: dark;
      --ink: #f4f4f4;
      --muted: #b6b6b6;
    }
    html,
    body {
      background: #0b0b0b;
    }
    .logo {
      filter: invert(1);
    }
  }
</style>
